generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Resource scope granted by a share.
enum ShareTargetType {
  DATA_ROOM
  FOLDER
  FILE
}

/// How a share is accessed.
enum ShareAccessType {
  PUBLIC_LINK
  USER
}

/// Permissions available through a share.
enum ShareRole {
  VIEWER
  EDITOR
}

/// Scope removed by a durable background deletion job.
enum DeletionTargetType {
  DATA_ROOM
  FOLDER
}

/// Local profile mirrored from Supabase Auth.
model User {
  id        String   @id // Matches auth.users.id from Supabase
  email     String   @unique
  fullName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Rooms owned by this user.
  dataRooms      DataRoom[]
  shares         Share[]         @relation("SharedWithUser")
  uploadSessions UploadSession[]
  deletionJobs   DeletionJob[]
}

/// Workspace that owns folders, files, and shares.
model DataRoom {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Supabase user who owns the workspace.
  ownerId     String
  /// Set while a durable deletion job removes its contents.
  deletionRequestedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folders        Folder[]
  files          File[]
  shares         Share[]
  uploadSessions UploadSession[]
  deletionJobs   DeletionJob[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, deletionRequestedAt])
}

/// Hierarchical container within a Data Room.
model Folder {
  id         String   @id @default(uuid())
  dataRoomId String
  parentId   String?
  name       String
  /// Materialized path used for subtree queries.
  path       String
  depth      Int      @default(0)
  /// Set on the root of a subtree queued for deletion.
  deletionRequestedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dataRoom       DataRoom        @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parent         Folder?         @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Folder[]        @relation("FolderTree")
  files          File[]
  shares         Share[]
  uploadSessions UploadSession[]
  deletionJobs   DeletionJob[]

  @@unique([dataRoomId, parentId, name])
  @@index([dataRoomId, parentId, name])
  @@index([dataRoomId, parentId, name, id])
  @@index([dataRoomId, path])
  @@index([dataRoomId, deletionRequestedAt])
}

/// Metadata for a private file in Supabase Storage.
model File {
  id          String   @id @default(uuid())
  dataRoomId  String
  folderId    String?
  name        String
  /// Unique object key in the private storage bucket.
  storagePath String   @unique
  mimeType    String
  sizeBytes   BigInt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dataRoom DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares   Share[]

  @@unique([dataRoomId, folderId, name])
  @@index([dataRoomId, folderId, name])
  @@index([dataRoomId, folderId, name, id])
}

/// Temporary record for a direct upload awaiting confirmation.
model UploadSession {
  id          String   @id @default(uuid())
  dataRoomId  String
  folderId    String?
  ownerId     String
  name        String
  storagePath String   @unique
  sizeBytes   BigInt
  /// Time after which the incomplete upload is cleaned up.
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  dataRoom DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiresAt])
  @@index([dataRoomId, folderId])
}

/// Durable, idempotent work item for deleting a large Data Room or folder subtree.
model DeletionJob {
  id            String             @id @default(uuid())
  dataRoomId    String
  folderId      String?
  targetType    DeletionTargetType
  /// Captures a folder scope even if the folder relation is cleared on completion.
  folderPath    String?
  requestedById String
  deletedFiles  Int                @default(0)
  deletedUploads Int               @default(0)
  completedAt   DateTime?
  lockedUntil   DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  dataRoom    DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  requestedBy User     @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([completedAt, lockedUntil])
  @@index([dataRoomId, completedAt])
  @@index([requestedById, completedAt])
}

/// Access grant for a room, folder, or file.
model Share {
  id             String          @id @default(uuid())
  dataRoomId     String
  folderId       String?
  fileId         String?
  targetType     ShareTargetType
  accessType     ShareAccessType
  /// Registered recipient for a user share.
  recipientId    String?
  recipientEmail String?
  /// Secret token used by a public link.
  token          String?         @unique
  description    String?
  role           ShareRole       @default(VIEWER)
  expiresAt      DateTime?
  /// Revocation time; null means the share is active.
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())

  dataRoom  DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  file      File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  recipient User?    @relation("SharedWithUser", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, revokedAt])
  @@index([recipientEmail, revokedAt])
  @@index([token, revokedAt])
}
